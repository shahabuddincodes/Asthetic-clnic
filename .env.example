# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=4000

# Long random string, e.g. from:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Website address(es) allowed to call the API, comma separated
ALLOWED_ORIGINS=https://drmujahid.com,https://www.drmujahid.com
# Used in "manage your booking" links sent to patients
SITE_URL=https://drmujahid.com

# Where the SQLite database lives (keep it on a persistent disk and back it up)
DATABASE_FILE=./data/clinic.db

# Behind Nginx/Render/Railway etc. set to 1 so rate limits see the real visitor IP
TRUST_PROXY=1

# ── Notifications (optional; without them messages are logged to the console) ──
# Clinic inbox for new bookings, cancellations and contact messages
CLINIC_NOTIFY_EMAIL=hello@drmujahid.com
# Any SMTP server, e.g. smtps://user:password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM="Dr. Mujahid Aesthetics <hello@drmujahid.com>"

# WhatsApp Cloud API (Meta Business). Business-initiated messages need an approved template
# with one body variable {{1}}; the full message text is sent in it.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Reminder sender (24h and 2h before). Set to off to disable.
REMINDERS=on
